<div class="seymour-root {% if isOpen %}is-open{% endif %}">
  <div class="seymour-scrim"></div>

  <div class="seymour-selector {{ selectorSize }}">
    <div class="seymour-strip">
      {% for channel in channels %}
        <div class="seymour-item {% if loop.index0 === activeIndex %}active{% endif %}">
          <img src="{{ channel.thumbnailUrl }}" alt="{{ channel.label }}">
          {% if showLabels %}
            <div class="seymour-label">{{ channel.label }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>
